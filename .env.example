# ==============================================================================
# Myntra Wishlist AI Discovery & Intelligence Engine - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Configuration (Google AI Studio / Gemini)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Multi-Channel Data Ingestion Credentials (Optional)
# ------------------------------------------------------------------------------
# Reddit API (PRAW) - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=MyntraWishlistBot/1.0

# YouTube Data API v3 - https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite Data Lake (zero setup required)
DATABASE_URL=sqlite:///data/myntra_wishlist_lake.db

# Optional: PostgreSQL Database (for production deployments)
# DATABASE_URL=postgresql://user:password@localhost:5432/myntra_wishlist_lake

# ------------------------------------------------------------------------------
# 4. App & Streamlit Environment
# ------------------------------------------------------------------------------
APP_ENV=development
